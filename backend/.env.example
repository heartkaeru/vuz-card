# Copy to backend/.env and fill locally. Never commit credentials.
GIGACHAT_CREDENTIALS=
# Choose an available model and the scope issued for your account.
GIGACHAT_MODEL=
GIGACHAT_SCOPE=
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_TIMEOUT=60
GIGACHAT_MAX_RETRIES=2
GIGACHAT_MAX_OUTPUT_TOKENS=4096
# Optional path to a trusted CA bundle. TLS verification stays enabled.
GIGACHAT_CA_BUNDLE_FILE=
