# Copy to backend/.env and fill locally. Never commit credentials.
# Generate a stable random key, for example with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=1440
# Supabase PostgreSQL connection string from Dashboard > Connect (server only; never NEXT_PUBLIC_).
DATABASE_URL=
GIGACHAT_CREDENTIALS=
# Choose an available model and the scope issued for your account.
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# api.giga.chat/v1 отвечает 404: рабочий адрес — devices.sberbank.ru.
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_TIMEOUT=60
GIGACHAT_MAX_RETRIES=2
GIGACHAT_MAX_OUTPUT_TOKENS=4096
# Optional path to a trusted CA bundle. TLS verification stays enabled.
GIGACHAT_CA_BUNDLE_FILE=
