# Copy to backend/.env and fill locally. Never commit credentials.
# Generate a stable random key, for example with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=1440
GIGACHAT_CREDENTIALS=
# Choose an available model and the scope issued for your account.
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# api.giga.chat/v1 отвечает 404: рабочий адрес — devices.sberbank.ru.
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_TIMEOUT=60
GIGACHAT_MAX_RETRIES=2
GIGACHAT_MAX_OUTPUT_TOKENS=4096
# Optional path to a trusted CA bundle. TLS verification stays enabled.
GIGACHAT_CA_BUNDLE_FILE=

# --- Парсер ---
# Официальные API поисковиков (необязательно). Без них Яндекс и Google часто
# отвечают капчей, и поиск сайта и новостей о Сбере уходит в Bing/DuckDuckGo.
# Yandex Search API (Yandex Cloud): идентификатор каталога и API-ключ.
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
# Google Programmable Search: ключ API и идентификатор поисковой системы.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# Разделы официального сайта (через запятую) и размер блока руководства.
PARSER_SECTIONS=about,leadership,contacts,programs,research,projects,partnerships,news,events
PARSER_MAX_LEADERSHIP=20
# Глубина новостей о сотрудничестве со Сбером, месяцев.
PARSER_NEWS_MONTHS=24
# Браузерный рендеринг для SPA-сайтов и проверок «вы не бот» (нужен Chromium).
PARSER_PLAYWRIGHT=1
# Сколько Chromium может работать одновременно (каждый ~250–400 МБ) и сколько
# секунд задание ждёт свободный браузер. Для сервера на 2 ГБ — 1.
PARSER_MAX_BROWSERS=1
PARSER_BROWSER_WAIT=180
